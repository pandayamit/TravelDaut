<% layout("/layouts/boilerplate") %>

    <div class="row mt-3">
        <h1 class="col-6 offset-3">SignUp on TravelDaut</h1>
        <div class="col-6 offset-3">
            <form action="/signup" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" id="username" placeholder="enter your username" name="username" required
                        class="form-control" />
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Oops! you missed the username here</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" id="email" placeholder="enter your email" name="email" required
                        class="form-control" />
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Oops! you missed the email here</div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" id="password" placeholder="enter your password" name="password" required
                        class="form-control" />
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Oops! you missed the password here</div>
                </div>
                <button class=" mb-2 btn btn-success">
                    SignUp
                </button>
            </form>
        </div>
    </div>