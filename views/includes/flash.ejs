<!-- <h1>flash message for success</h1> -->


<% if( success && success.length){ %>
<div class="alert alert-success alert-dismissible fade show" role="alert">
     <%= success %>
     <button 
     type="button"
     class="bt-close"
     data-bs-dismiss="alert"
     arisa-label="close"
     ></button>
</div>
<% } %>

<% if( error && error.length){ %>
<div class="alert alert-danger alert-dismissible fade show offset-5" role="alert">
     <%= error %>
     <button 
     type="button"
     class="bt-close"
     data-bs-dismiss="alert"
     arisa-label="close"
     ></button>
</div>
<% } %>
